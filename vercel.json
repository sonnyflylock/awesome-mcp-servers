{
  "version": 2,
  "name": "imagentext",
  "public": true,
  "rewrites": [
    { "source": "/", "destination": "/imagentext-website/index.html" },
    { "source": "/css/:path*", "destination": "/imagentext-website/css/:path*" },
    { "source": "/js/:path*", "destination": "/imagentext-website/js/:path*" },
    { "source": "/images/:path*", "destination": "/imagentext-website/images/:path*" },
    { "source": "/:path*", "destination": "/imagentext-website/:path*" }
  ],
  "headers": [
    {
      "source": "/imagentext-website/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/imagentext-website/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
